server {
    listen 80;
    listen [::]:80;
    server_name wcuedu.net www.wcuedu.net 137.131.34.58;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wcuedu.net www.wcuedu.net 137.131.34.58;

    root /var/www/wcu-site;
    index index.html;

    ssl_certificate /opt/wcu-front/certs/wcuedu-origin.crt;
    ssl_certificate_key /opt/wcu-front/certs/wcuedu-origin.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:WCU_TLS:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /var/log/nginx/wcu-front-access.log;
    error_log /var/log/nginx/wcu-front-error.log warn;

    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 15s;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://161.153.87.137;
        proxy_http_version 1.1;
        proxy_set_header Host 161.153.87.137;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location /admin/ {
        proxy_pass http://161.153.87.137;
        proxy_http_version 1.1;
        proxy_set_header Host 161.153.87.137;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ~ /\. {
        deny all;
    }
}
